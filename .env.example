# discount_checker 환경변수 설정
# 이 파일을 복사해서 .env 로 저장하고 값을 채워주세요.
# .env 는 절대 Git에 커밋하지 마세요.

# Meta Marketing API
# 발급: Meta Business → 설정 → 시스템 사용자 → 액세스 토큰 (ads_read 권한)
META_ACCESS_TOKEN=your_meta_access_token_here

# Meta 광고 계정 ID (act_ 포함)
# 확인: business.facebook.com/adsmanager → 계정 ID 앞에 act_ 붙이기
META_AD_ACCOUNT_ID=act_XXXXXXXXXXXXXXXXX

# Anthropic API 키 (팀 계정)
# 발급: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-XXXXXXXX

# Slack 웹훅 URL (선택 — 불일치 건 알림)
# 발급: api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=
